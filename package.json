    "node": ">=20"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.24.0",
    "playwright-core": "^1.48.0",
    "postject": "^1.0.0-alpha.6"
  }
}
