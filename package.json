{
  "name": "nilcode-ai",
  "version": "0.1.0",
  "description": "NILCODE AI — AI-powered autonomous software development environment",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test --test-force-exit",
