node_modules/
nullcode.db
nullcode.db-*
.nullcode/
.nullcode-data/
.freebuff/
.env
.env.*
*.log
dist/
build/
# Desktop build resources are SOURCE (brand icons, mac entitlements) and must
# be tracked; the generic build/ rule above would hide them from CI clones.
!desktop/build/
desktop/build/*
!desktop/build/appicon.png
!desktop/build/entitlements.mac.plist
!desktop/build/installerIcon.ico
coverage/
*.exe
*.blob
*.cjs
# …but the Electron desktop entry point and builder config are source code:
!desktop/main.cjs
!desktop/builder.config.cjs
desktop/dist-desktop/
desktop/server-bundle.cjs
desktop/app-server/
.electron-cache/
